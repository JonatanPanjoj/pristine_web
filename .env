# Pristine Backend Configuration (Express)
SERVER_PORT=5000

# Pristine Frontend Configuration (React Scripts corre en el puerto 3000)
PORT=3000

# Para MongoDB Local:
MONGODB_URI=mongodb://localhost:27017/pristine
# Para MongoDB en AWS (Ejemplo):
# MONGODB_URI=mongodb://pristineUser:tuPassword@tu-servidor-aws.com:27017/pristine?authSource=admin

# Pristine Frontend Configuration
# En local:
REACT_APP_API_URL=http://localhost:5000/api
# En AWS: cambiar por la IP pública o dominio del servidor backend en AWS:
# REACT_APP_API_URL=http://<IP-O-DOMINIO-AWS>:5000/api

# Servidor 3 de Almacenamiento de Imágenes (SRV-03 en AWS)
REACT_APP_STORAGE_URL=http://3.130.212.65:8080

# Llave de encriptación interna para almacenamiento seguro local
REACT_APP_KEYENCRIPT=PristineSecurityKey2026AES
