# Etapa 1: Compilación de React
FROM node:18-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .

# Argumento para inyectar la URL del backend y storage durante el build
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

ARG REACT_APP_STORAGE_URL
ENV REACT_APP_STORAGE_URL=$REACT_APP_STORAGE_URL

ENV GENERATE_SOURCEMAP=false

RUN npm run build

# Etapa 2: Servidor Web Nginx de producción
FROM nginx:alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
